# Copy this file to `.env` and fill in your own values. `.env` is gitignored -
# never commit real secrets. See README.md for full setup instructions.
#
# This file is used two ways:
#  1. `docker compose up` reads it automatically (from this directory) to fill
#     in the ${VARS} in docker-compose.yml.
#  2. If you run the backend directly with `mvnw spring-boot:run` instead of
#     Docker, export these as real environment variables first (README shows
#     the one-line command for bash/PowerShell).

# ---- Database --------------------------------------------------------------
# Used by docker-compose to set the MySQL root password (also becomes DB_PASSWORD below).
MYSQL_ROOT_PASSWORD=change-me-local-only

# Only needed if you run the backend OUTSIDE Docker (mvnw spring-boot:run) and
# connect to a MySQL instance on your host machine (e.g. the one docker-compose
# starts, published on localhost:3306). Not used when running via `docker compose up`
# (the app container talks to the `db` service directly).
DB_URL=jdbc:mysql://localhost:3306/salessavvy?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me-local-only

# `validate` (the app default) expects tables to already exist - correct for
# production, where schema changes are reviewed separately. For a fresh local
# database, set this to `update` so Hibernate creates the tables for you on
# first run. Never use `update`/`create` in production (enforced at startup).
DDL_AUTO=update

# ---- App behavior (local/dev) ----------------------------------------------
APP_PRODUCTION=false

# Auth cookies over plain http://localhost must NOT be Secure, and SameSite
# must be Lax (browsers reject SameSite=None without Secure). Production
# behind HTTPS should use AUTH_COOKIE_SECURE=true / AUTH_COOKIE_SAME_SITE=None.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Populate the catalog with demo products/categories and create an admin
# account on first startup. Safe for local dev; production startup fails if
# either of these is left on (see ProductionConfigurationValidator).
SEED_DEMO_DATA=true
SEED_ADMIN=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-local-only

# Frontend origin(s) allowed to call this API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5174

# ---- Third-party integrations -----------------------------------------------
# Create a free Razorpay test-mode account to get these (dashboard.razorpay.com).
# Checkout/payment features won't work until both are set.
RAZORPAY_KEY_ID=your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret

# Create an OAuth client at console.cloud.google.com to get this.
# Google Sign-In won't work until this is set - it must match the frontend's
# VITE_GOOGLE_CLIENT_ID (ShopKart-UI/.env).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---- Optional -----------------------------------------------------------
# JWT_SECRET must be >= 64 bytes if set; the built-in dev default is fine for
# local use and is rejected automatically if APP_PRODUCTION=true.
# JWT_SECRET=
# PORT=9090
